# ===== Chung =====
PORT=8787
# demo  : dữ liệu mẫu trong bộ nhớ (mất khi tắt server, KHÔNG đụng tới Google Sheets)
# sheets: dữ liệu thật trên Google Sheets
DATA_SOURCE=demo

# Danh sách size mặc định hiển thị trên form (vẫn nhập được size khác)
SIZES=S,M,L,XL

# ===== Đăng nhập =====
# Chuỗi ngẫu nhiên dài >= 32 ký tự, ví dụ: openssl rand -base64 48
SESSION_SECRET=
# Thời gian giữ đăng nhập (ngày)
SESSION_DAYS=30
# Danh sách tài khoản, phân tách bằng dấu phẩy: tên:mã-băm
# Tạo mã băm: npm run hash-password -- <mật-khẩu>
APP_USERS=

# ===== Google Sheets (khi DATA_SOURCE=sheets) =====
# ID nằm trong URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Cách 1: đường dẫn tới file JSON của service account (đặt ngoài thư mục public, không commit)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Cách 2 (khi deploy): dán email + private key của service account
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Thời gian cache dữ liệu đọc từ Sheets trên server (ms). Sửa tay trên Sheets sẽ hiện sau khoảng này.
SHEETS_CACHE_MS=15000

# ===== Giao Hàng Nhanh (GHN) — https://developer.ghn.vn =====
# Bỏ trống GHN_TOKEN: chế độ demo dùng GHN giả lập, chế độ sheets tắt tính năng GHN.
# Token + ShopId: đăng nhập khachhang.ghn.vn (thử nghiệm: 5sao.ghn.dev) → Chủ cửa hàng / Quản lý cửa hàng.
GHN_TOKEN=
GHN_SHOP_ID=
# staging (dev-online-gateway.ghn.vn, đơn thử không giao thật) | production
GHN_ENV=staging
# Bí mật xác thực webhook: khai báo "Header tùy chỉnh" X-Webhook-Secret=<giá trị này> khi cấu hình webhook trên GHN.
# Bỏ trống = tắt webhook (vẫn cập nhật trạng thái bằng nút "Đồng bộ GHN"). Tạo: openssl rand -hex 24
GHN_WEBHOOK_SECRET=
# Địa chỉ lấy hàng — chỉ cần khi shop trên GHN chưa khai báo địa chỉ (lỗi FROM_ADDRESS_CONVERT_FAIL).
# Tên phường/tỉnh viết đúng như danh mục MỚI của GHN (ví dụ "Phường Cầu Giấy", "Hà Nội"). Hàng hoàn cũng trả về đây.
# GHN_FROM_NAME=
# GHN_FROM_PHONE=
# GHN_FROM_ADDRESS=12 Trần Thái Tông
# GHN_FROM_WARD=Phường Cầu Giấy
# GHN_FROM_PROVINCE=Hà Nội
# Giá trị mặc định trên form gửi GHN (sửa được mỗi lần gửi)
GHN_DEFAULT_ITEM_WEIGHT=300
GHN_DEFAULT_DIMENSIONS=25x20x5
# CHOXEMHANGKHONGTHU | CHOTHUHANG | KHONGCHOXEMHANG
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
# 2 = người nhận trả phí ship, 1 = shop trả
GHN_PAYMENT_TYPE=2
